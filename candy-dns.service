# candy-dns systemd service (template — rendered by install-service.sh)
# Install with: bun run install-dns-service
# Enable with:  sudo systemctl enable --now candy-dns

[Unit]
Description=candy-dns - DNS server for .candy TLD via Tailscale
After=network.target tailscaled.service

[Service]
Type=simple
# Runs as the same user as the daemon so both can share /tmp/candy-logs.
# Port 53 is granted via CAP_NET_BIND_SERVICE; no root needed.
User=__USER__
Environment="HOME=__HOME__"
Environment="PATH=__BUN_DIR__:__HOME__/.bun/bin:/usr/local/bin:/usr/bin:/bin"
WorkingDirectory=__CANDY_DIR__
ExecStart=__BUN__ run candy-dns.ts
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
